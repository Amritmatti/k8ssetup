# -----------------------------------------------------------------------------
#  OPTIONAL: creates the VirtualBox VMs themselves.
#  Skip this file entirely if your VMs already exist -- deploy.sh only needs
#  SSH access. Keep the list below in sync with NODES in cluster.conf.
#
#      vagrant up            # build the VMs
#      ./deploy.sh deploy    # build the cluster on them
#
#  Vagrant's default user is 'vagrant' with passwordless sudo, which is what
#  cluster.conf assumes. Vagrant boxes get NAT on eth0 and the private_network
#  address on eth1 -- that eth1 address is the one you put in cluster.conf.
# -----------------------------------------------------------------------------
BOX      = "bento/ubuntu-24.04"
NETMASK  = "255.255.255.0"

NODES = [
  # name,       ip,               cpus, memory(MB)
  ["master-1", "192.168.1.180", 2, 2560],
  ["master-2", "192.168.1.181", 2, 2560],
  ["master-3", "192.168.1.182", 2, 2560],
  ["worker-1", "192.168.1.183", 2, 2560],
  ["worker-2", "192.168.1.184", 2, 2560],
  ["worker-3", "192.168.1.185", 2, 2560],
]

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false
  # Same insecure key on every VM; deploy.sh talks to them over plain SSH.
  config.ssh.insert_key = false

  NODES.each do |name, ip, cpus, mem|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: ip, netmask: NETMASK
      node.vm.provider "virtualbox" do |vb|
        vb.name   = "k8s-#{name}"
        vb.cpus   = cpus
        vb.memory = mem
        # Keepalived's VRRP multicast + the floating VIP need promiscuous mode
        # on the host-only adapter.
        vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
        vb.customize ["modifyvm", :id, "--groups", "/k8s-lab"]
      end
      # Let root log in with the vagrant key too, so SSH_USER=root also works.
      node.vm.provision "shell", inline: <<-SHELL
        mkdir -p /root/.ssh
        cp /home/vagrant/.ssh/authorized_keys /root/.ssh/authorized_keys
        chmod 700 /root/.ssh; chmod 600 /root/.ssh/authorized_keys
      SHELL
    end
  end
end
